{
  "schema": 1,
  "note": "Pure scan/plan fixtures. Each case is checked as LF, CRLF, CR. No font/PSD writes.",
  "cases": [
    {
      "id": "mixed_notation",
      "description": "同じ数式本体を四つの記法で再利用",
      "source": "前 $x^2$ / $$x^2$$ / \\(x^2\\) / \\[x^2\\] 後",
      "expected": {
        "latex": [
          "x^2",
          "x^2",
          "x^2",
          "x^2"
        ],
        "issues": [],
        "protectedCount": 0,
        "fatal": false
      }
    },
    {
      "id": "vectors",
      "description": "実際に検出漏れが報告された二式",
      "source": "$$ (1.02,0.01,0.00) $$\n$$ (2.8,-0.4,-0.2) $$",
      "expected": {
        "latex": [
          "(1.02,0.01,0.00)",
          "(2.8,-0.4,-0.2)"
        ],
        "issues": [],
        "protectedCount": 0,
        "fatal": false
      }
    },
    {
      "id": "python_before_vectors",
      "description": "閉じたPythonコードの後の二式",
      "source": "```{python}\nlabel = \"$not_math$\"\n```\n$$ (1.02,0.01,0.00) $$\n$$ (2.8,-0.4,-0.2) $$",
      "expected": {
        "latex": [
          "(1.02,0.01,0.00)",
          "(2.8,-0.4,-0.2)"
        ],
        "issues": [],
        "protectedCount": 1,
        "fatal": false
      }
    },
