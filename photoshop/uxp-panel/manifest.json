{
  "manifestVersion": 5,
  "id": "com.adobe-inline-math.local-lab",
  "name": "Paper Math",
  "version": "0.8.1",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "inlineMathPanel",
      "label": {
        "default": "Paper Math"
      },
      "minimumSize": {
        "width": 300,
        "height": 280
      },
      "maximumSize": {
        "width": 1200,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 520
      },
      "preferredFloatingSize": {
        "width": 460,
        "height": 600
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "clipboard": "readAndWrite",
    "localFileSystem": "request",
    "launchProcess": {
      "extensions": [
        ".html"
      ]
    }
  }
}
